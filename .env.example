# Copy this file to .env (in the repo root) and fill in what you need.
# Only used for local, non-Docker development - the Docker image reads
# everything from real environment variables instead (see docker-compose.yml).

# Generate with: openssl rand -hex 32
# The app refuses to start if this is left at its default value.
# Also encrypts authenticator secrets. Keep stable and back up with the database.
SECRET_KEY=change-me-in-production

# Set to true when serving over HTTPS, so the auth cookie is marked secure.
COOKIE_SECURE=false

# Set to true to expose /docs and /redoc on the backend.
DOCS_ENABLED=false

# Your real external URL. Used to build links in outgoing emails (e.g. the
# password reset link).
SERVER_URL=http://localhost:4258

# IANA timezone name used to compute "today" for the dashboard and the reminder scheduler - e.g. what day a Dec 31 birthday rolls over
# to Jan 1 on. Defaults to UTC, which is almost never what you want for a
# single-instance, single-timezone household app like this one.
TIMEZONE=UTC

# Registrations are disabled by default. Set to true to allow additional
# users; the very first account can always be created regardless of this.
ENABLE_REGISTRATIONS=false
REGISTRATION_MAX_ALLOWED_USERS=0

# Override the SQLite file location if you need to (rarely necessary).
#DATABASE_URL=sqlite:///./data/candlr.db

# OIDC / SSO - uncomment and fill in to enable. OIDC_REDIRECT_URL must point
# at this app's /oidc-callback page and be registered with your provider.
#OIDC_ENABLED=true
#OIDC_PROVIDER_NAME=SSO
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_AUTH_URL=
#OIDC_TOKEN_URL=
#OIDC_USERINFO_URL=
#OIDC_REDIRECT_URL=http://localhost:4258/oidc-callback
#OIDC_IDENTIFIER_FIELD=email
#OIDC_SCOPES=openid email profile
#OIDC_AUTO_CREATE_USERS=true
#OIDC_DISABLE_PASSWORD_LOGIN=false

# SMTP - uncomment and fill in to enable the email notification channel and
# forgot/reset password. Leave commented and both stay unavailable.
#SMTP_ADDRESS=smtp.gmail.com
#SMTP_PORT=587
#SMTP_ENCRYPTION=tls
#SMTP_USERNAME=
#SMTP_PASSWORD=
#FROM_EMAIL=

# Web push (device notifications) - uncomment and fill in to enable. Generate
# a pair with: python scripts/generate_vapid_keys.py
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com
