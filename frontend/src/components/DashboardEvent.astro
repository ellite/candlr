---
import { initials } from "../lib/avatar.js";
import { MONTH_NAMES, splitNumber } from "../lib/dates.js";
import { milestone, type DashboardEntry } from "../lib/dashboard";

interface Props { entry: DashboardEntry; prominent?: boolean; past?: boolean }
const { entry: { person, event }, prominent = false, past = false } = Astro.props;
const occasion = milestone(event, new Date(), past ? -event.days_since : event.days_until);
const occasionParts = occasion ? splitNumber(occasion) : null;
const due = past
  ? event.days_since === 1 ? "Yesterday" : `${event.days_since} days ago`
  : event.days_until === 0 ? "Today" : event.days_until === 1 ? "Tomorrow" : `In ${event.days_until} days`;
---

<a href={`/events?open=${person.id}`} data-person-id={person.id} class:list={[
  "card flex items-center gap-3 min-w-0 p-4 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors",
  prominent && "sm:p-5",
]}>
  {person.image_url ? (
    <img src={`/api${person.image_url}`} alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0" />
  ) : (
    <div class="w-12 h-12 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 flex items-center justify-center flex-shrink-0 text-sm font-medium">{initials(person.name)}</div>
  )}
  <div class="min-w-0 flex-1">
    <p class="font-medium text-sm break-words">{person.name}</p>
    <p class="text-xs text-zinc-600 dark:text-zinc-300 break-words mt-0.5">
      {event.event_type.name}
      {occasionParts && (
        <>
          {" · "}
          {occasionParts.before}<strong class="font-semibold text-accent dark:text-accent-light">{occasionParts.number}</strong>{occasionParts.after}
        </>
      )}
    </p>
    <p class="text-xs mt-2 text-zinc-600 dark:text-zinc-300">
      <span class:list={[prominent && "text-accent dark:text-accent-light font-medium"]}>{due}</span>
      {(past || event.days_until > 0) && ` · ${MONTH_NAMES[event.month - 1]} ${event.day}`}
    </p>
  </div>
</a>
