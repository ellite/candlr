---
// Shared by Events and the dashboard - viewing a card's dates and deleting
// a date/card works the same in both places, wired up by ../lib/personDetail.js.
// Editing (add/edit a date, edit the card itself) hands off to whichever
// callback the including page provides, since the add/edit form + image
// cropper only exist on the Events page.
---

<div id="detail-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center">
  <div class="detail-backdrop absolute inset-0 bg-black/40"></div>
  <div class="relative bg-surface dark:bg-surface-dark w-full min-w-0 max-w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl max-h-[92dvh] overflow-y-auto p-6">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3 min-w-0">
        <div id="detail-avatar-wrap" class="relative flex-shrink-0"></div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <h2 id="detail-name" class="text-base font-semibold truncate"></h2>
            <button type="button" id="detail-edit-card-btn" class="icon-button btn-ghost p-1 flex-shrink-0" aria-label="Edit card" title="Edit card">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <button type="button" class="detail-close icon-button btn-ghost p-1.5 flex-shrink-0" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="detail-events" class="space-y-3 mb-4"></div>

    <button id="detail-add-event-btn" class="btn-secondary w-full text-sm mb-4">+ Add another date</button>

    <div class="pt-4 border-t">
      <button id="detail-delete-person-btn" type="button" class="w-full text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
        Delete this card
      </button>
    </div>
  </div>
</div>

<!-- Delete confirmation (shared for event / person) -->
<div id="confirm-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
  <div class="confirm-backdrop absolute inset-0 bg-black/40"></div>
  <div class="relative card p-6 w-full max-w-sm">
    <h2 id="confirm-title" class="text-base font-semibold mb-1.5">Delete?</h2>
    <p id="confirm-message" class="text-sm text-zinc-600 dark:text-zinc-300 mb-4"></p>
    <div class="flex gap-2 justify-end">
      <button type="button" class="confirm-cancel btn-secondary">Cancel</button>
      <button type="button" id="confirm-delete-btn"
        class="text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
        Delete
      </button>
    </div>
  </div>
</div>
