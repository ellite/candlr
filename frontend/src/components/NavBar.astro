---
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";

interface Props {
  user: { username: string; is_admin?: boolean };
  activePage?: "dashboard" | "events" | "calendar" | "settings" | "admin";
}
const { user, activePage } = Astro.props;

const links = [
  { page: "dashboard", href: "/", label: "Dashboard", path: "m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" },
  { page: "events", href: "/events", label: "Events", path: "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" },
  { page: "calendar", href: "/calendar", label: "Calendar", path: "M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" },
];
---

<header class="sticky top-0 z-30 flex items-center gap-2 sm:gap-6 px-3 sm:px-6 pt-0.5 h-14
               bg-surface/90 dark:bg-surface-dark/90 backdrop-blur-md border-b">
  <a href="/" class="flex items-center flex-shrink-0" aria-label="Candlr home">
    <Logo size="sm" />
  </a>

  <nav aria-label="Main navigation" class="hidden sm:flex items-center gap-1 flex-1 min-w-0">
    {links.map(({ page, href, label, path }) => (
      <a href={href}
         aria-current={activePage === page ? "page" : undefined}
         class={`flex items-center gap-1.5 px-2 sm:px-2.5 py-1.5 rounded-lg text-xs sm:text-sm transition-colors ${
           activePage === page
             ? "text-zinc-900 dark:text-white font-medium"
             : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
         }`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={path} />
        </svg>
        {label}
      </a>
    ))}
  </nav>

  <div class="flex items-center gap-1 flex-shrink-0 ml-auto">
    <ThemeToggle />

    <div class="relative pl-1 sm:pl-3 sm:ml-1 border-l">
      <button
        id="user-menu-btn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        class="flex items-center gap-2 px-1.5 py-1 rounded-lg hover:bg-zinc-100 dark:hover:bg-white/5 transition-colors"
      >
        <div class="w-6 h-6 rounded-full bg-zinc-900 dark:bg-white flex items-center justify-center flex-shrink-0">
          <span class="text-[10px] font-medium text-white dark:text-zinc-900">
            {user.username[0]?.toUpperCase()}
          </span>
        </div>
        <span class="hidden sm:inline text-sm text-zinc-600 dark:text-zinc-400 max-w-[140px] truncate">{user.username}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="hidden sm:block w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <div
        id="user-menu"
        hidden
        class="absolute right-0 top-[calc(100%+0.5rem)] w-44 py-1 card shadow-lg"
      >
        {user.is_admin && (
          <a
            href="/admin"
            class={`flex items-center gap-2 px-3 py-2 text-sm transition-colors ${
              activePage === "admin"
                ? "text-zinc-900 dark:text-white font-medium"
                : "text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5"
            }`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3.5v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5L12 3z" />
            </svg>
            Admin
          </a>
        )}
        <a
          href="/settings"
          class={`flex items-center gap-2 px-3 py-2 text-sm transition-colors ${
            activePage === "settings"
              ? "text-zinc-900 dark:text-white font-medium"
              : "text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5"
          }`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          Settings
        </a>
        <a
          href="/about"
          class="flex items-center gap-2 px-3 py-2 text-sm text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4M12 8h.01"/>
          </svg>
          About
        </a>
        <div class="my-1 border-t"></div>
        <button
          id="logout-btn"
          type="button"
          class="flex items-center gap-2 w-full px-3 py-2 text-sm text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/5 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Log out
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("user-menu-btn");
  const menu = document.getElementById("user-menu");

  function closeMenu() {
    menu?.setAttribute("hidden", "");
    menuBtn?.setAttribute("aria-expanded", "false");
  }
  function openMenu() {
    menu?.removeAttribute("hidden");
    menuBtn?.setAttribute("aria-expanded", "true");
  }

  menuBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (menu?.hasAttribute("hidden")) openMenu();
    else closeMenu();
  });

  document.addEventListener("click", (e) => {
    if (!menu || menu.hasAttribute("hidden")) return;
    if (!(e.target instanceof Node)) return;
    if (menu.contains(e.target) || menuBtn?.contains(e.target)) return;
    closeMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/login";
  });
</script>
