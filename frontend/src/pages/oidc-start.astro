---
import Layout from "../layouts/Layout.astro";
import { apiJson } from "../lib/api";

// Initiate the OIDC flow: get the provider's auth URL and a fresh state token
// from the backend, set the state as an httpOnly cookie on the browser, then
// redirect the browser to the provider. The backend is never contacted by
// the browser directly.

let errorMsg = "";

const rawNext = Astro.url.searchParams.get("next") || "";
const nextPath = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "/";

try {
  const { auth_url, state } = await apiJson<{ auth_url: string; state: string }>("/oidc/authorize");

  Astro.cookies.set("oidc_state", state, {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    maxAge: 600, // 10 minutes
  });
  Astro.cookies.set("oidc_next", nextPath, {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    maxAge: 600, // 10 minutes
  });

  return Astro.redirect(auth_url);
} catch (e: unknown) {
  errorMsg = (e as { detail?: string })?.detail || "Failed to start SSO login";
}
---

<Layout title="Signing in" fullPage>
  <div class="card p-6 text-center max-w-sm space-y-4">
    <p class="text-red-600 dark:text-red-400 text-sm">{errorMsg}</p>
    <a href="/login" class="btn-primary inline-block">Back to login</a>
  </div>
</Layout>
