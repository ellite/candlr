---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Logo from "../components/Logo.astro";
import AuthHero from "../components/AuthHero.astro";
import { apiJson } from "../lib/api";

if (Astro.cookies.get("candlr_token")?.value) {
  return Astro.redirect("/");
}

const cookies = Astro.request.headers.get("cookie") ?? "";
const passwordReset = await apiJson<{ enabled: boolean }>("/auth/password-reset-status", { cookies }).catch(() => ({
  enabled: false,
}));
---

<Layout title="Forgot password">
  <div class="min-h-dvh grid md:grid-cols-2">
    <AuthHero />

    <div class="relative flex items-center justify-center px-4 py-16">
      <div class="fixed top-4 right-4 z-20">
        <ThemeToggle class="p-2 rounded-lg bg-surface dark:bg-surface-dark border" />
      </div>

      <div class="w-full max-w-[360px]">
        <div class="mb-8">
          <div class="md:hidden mb-4">
            <Logo size="md" />
          </div>
          <h1 class="text-lg font-semibold tracking-tight">Reset your password</h1>
          <p class="text-zinc-600 dark:text-zinc-300 mt-1 text-sm">
            {passwordReset.enabled
              ? "Enter your account email and we'll send you a link."
              : "Password reset isn't available on this instance."}
          </p>
        </div>

        {passwordReset.enabled ? (
          <>
            <div class="card p-6 space-y-4" id="form-card">
              <div id="error-msg" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg"></div>
              <div>
                <label class="label" for="email">Email</label>
                <input id="email" class="input" type="email" autocomplete="email" placeholder="you@example.com" />
              </div>
              <button id="submit-btn" class="btn-primary w-full mt-1">Send reset link</button>
            </div>

            <div class="card p-6 hidden" id="success-card">
              <p class="text-sm text-zinc-600 dark:text-zinc-400">
                If that email is registered, a reset link has been sent. Check your inbox.
              </p>
            </div>
          </>
        ) : (
          <div class="card p-6">
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              Contact your administrator.
            </p>
          </div>
        )}

        <p class="text-sm text-zinc-600 dark:text-zinc-300 mt-4">
          <a href="/login" class="text-zinc-900 dark:text-zinc-100 font-medium hover:underline">Back to login</a>
        </p>
      </div>
    </div>
  </div>

  {passwordReset.enabled && (
    <script>
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      const errEl = document.getElementById("error-msg")!;
      const formCard = document.getElementById("form-card")!;
      const successCard = document.getElementById("success-card")!;

      async function submit() {
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.textContent = "Sending…";
        errEl.classList.add("hidden");

        try {
          const res = await fetch("/api/auth/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });
          if (!res.ok) {
            const text = await res.text();
            let detail = "Could not send reset link";
            try { detail = JSON.parse(text).detail ?? detail; } catch {}
            throw new Error(detail);
          }
          formCard.classList.add("hidden");
          successCard.classList.remove("hidden");
        } catch (e: any) {
          errEl.textContent = e.message;
          errEl.classList.remove("hidden");
          btn.disabled = false;
          btn.textContent = "Send reset link";
        }
      }

      btn.addEventListener("click", submit);
      document.getElementById("email")?.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Enter") submit();
      });
    </script>
  )}
</Layout>
