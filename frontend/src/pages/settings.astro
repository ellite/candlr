---
import Layout from "../layouts/Layout.astro";
import TwoFactorSettings from "../components/TwoFactorSettings.astro";
import PasswordInput from "../components/PasswordInput.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { apiJson, isUnauthorized, backendUnavailable } from "../lib/api";
import * as m from "../paraglide/messages.js";

const cookies = Astro.request.headers.get("cookie") ?? "";

type EventType = { id: number; name: string; is_default: boolean };
type CardDavAccount = {
  url: string;
  username: string;
  has_password: boolean;
  last_attempt_at: string | null;
  last_sync_at: string | null;
  last_error: string | null;
  last_result: { cards: number; added: number; updated: number; removed: number; skipped: number; errors: string[] } | null;
};
type NotificationChannel = { channel: string; enabled: boolean; config: Record<string, string> };

// Fired concurrently - see the same comment in index.astro. This page was
// the worst offender, four calls in series before this.
const [meResult, eventTypesResult, channelsResult, vapidResult, notifyPreferencesResult, carddavResult] = await Promise.allSettled([
  apiJson<{ username: string; email: string; has_password: boolean; is_admin: boolean }>("/auth/me", { cookies }),
  apiJson<EventType[]>("/event-types", { cookies }),
  apiJson<NotificationChannel[]>("/notifications/channels", { cookies }),
  apiJson<{ public_key: string | null }>("/notifications/webpush/public-key", { cookies }),
  apiJson<{ notify_time: string }>("/notifications/preferences", { cookies }),
  apiJson<CardDavAccount | null>("/carddav", { cookies }),
]);

if (meResult.status === "rejected") {
  if (!isUnauthorized(meResult.reason)) return backendUnavailable();
  Astro.cookies.delete("candlr_token", { path: "/" });
  return Astro.redirect("/login");
}
const user = meResult.value;
const eventTypes = eventTypesResult.status === "fulfilled" ? eventTypesResult.value : [];
const carddav = carddavResult.status === "fulfilled" ? carddavResult.value : null;
const channels = channelsResult.status === "fulfilled" ? channelsResult.value : [];
const vapidPublicKey = vapidResult.status === "fulfilled" ? vapidResult.value.public_key : null;
const cadenceLabel = (interval: number, unit: string) => {
  const one: Record<string, () => string> = { day: m.settings_every_day, week: m.settings_every_week, month: m.settings_every_month, year: m.settings_every_year };
  const many: Record<string, (p: { count: number }) => string> = { day: m.settings_every_n_days, week: m.settings_every_n_weeks, month: m.settings_every_n_months, year: m.settings_every_n_years };
  return interval === 1 ? one[unit]() : many[unit]({ count: interval });
};
const jsonExample = '{"people": [{"name": "Alex", "events": [{"type": "Birthday", "month": 3, "day": 5, "year": 1990}]}]}';
const notifyTime = notifyPreferencesResult.status === "fulfilled" ? notifyPreferencesResult.value.notify_time : "09:00";
---

<Layout title={m.settings_title()} user={{ username: user.username, is_admin: user.is_admin }} activePage="settings">
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-10 space-y-6">
    <div>
      <h1 class="text-lg font-semibold tracking-tight">{m.settings_title()}</h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mt-1">{m.settings_subtitle()}</p>
    </div>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-4">{m.settings_account_title()}</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-zinc-600 dark:text-zinc-300">{m.settings_username()}</dt>
          <dd class="font-medium">{user.username}</dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-zinc-600 dark:text-zinc-300">{m.settings_email()}</dt>
          <dd class="font-medium">{user.email}</dd>
        </div>
      </dl>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_language_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">{m.settings_language_description()}</p>
      <div class="max-w-xs">
        <LanguageSwitcher persist />
      </div>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_events_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        {m.settings_events_description()}
      </p>

      <ul id="event-type-list" class="space-y-1.5 mb-4">
        {eventTypes.map((et) => (
          <li class="flex items-center gap-2 px-2 py-2 rounded-lg bg-stone-50 dark:bg-white/5" data-event-type-id={et.id}>
            <button
              type="button"
              class="icon-button text-zinc-400 dark:text-zinc-500 cursor-grab touch-none flex-shrink-0 p-1"
              data-drag-handle
              aria-label={m.settings_drag_to_reorder()}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="9" cy="6" r="1.4" /><circle cx="9" cy="12" r="1.4" /><circle cx="9" cy="18" r="1.4" />
                <circle cx="15" cy="6" r="1.4" /><circle cx="15" cy="12" r="1.4" /><circle cx="15" cy="18" r="1.4" />
              </svg>
            </button>
            <span class="text-sm flex-1 truncate">{et.name}</span>
            {!(et.interval === 1 && et.unit === "year") && (
              <span class="text-xs text-zinc-500 dark:text-zinc-400 flex-shrink-0">
                {cadenceLabel(et.interval, et.unit)}
              </span>
            )}
            <button type="button" class="icon-button text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 flex-shrink-0 p-1" data-edit-event-type={et.id} data-name={et.name} data-interval={et.interval} data-unit={et.unit} data-is-default={et.is_default ? "true" : "false"} title={m.settings_edit()} aria-label={m.settings_edit_named({ name: et.name })}><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m16 4 4 4M4 20l4-1L20 7a2.12 2.12 0 0 0-3-3L5 16l-1 4Z" /></svg></button>
            {!et.is_default && <button
              class="icon-button text-zinc-400 hover:text-red-600 dark:hover:text-red-400 flex-shrink-0 p-1"
              data-delete-event-type={et.id}
              data-name={et.name}
              title={m.settings_delete()}
              aria-label={m.settings_delete_named({ name: et.name })}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>}
          </li>
        ))}
      </ul>

      <div id="event-type-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
      <button id="open-add-event-type-btn" type="button" class="btn-secondary">{m.settings_add_event_type()}</button>
    </section>

    <TwoFactorSettings hasPassword={user.has_password} />

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_password_title()}</h2>
      {user.has_password ? (
        <>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">{m.settings_password_description()}</p>
          <div id="password-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
          <div id="password-success" class="hidden bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
          <div class="space-y-4 max-w-sm">
            <div>
              <label class="label" for="current-password">{m.settings_current_password()}</label>
              <PasswordInput id="current-password" autocomplete="current-password" />
            </div>
            <div>
              <label class="label" for="new-password">{m.settings_new_password()}</label>
              <PasswordInput id="new-password" autocomplete="new-password" />
            </div>
            <div>
              <label class="label" for="confirm-new-password">{m.settings_confirm_new_password()}</label>
              <PasswordInput id="confirm-new-password" autocomplete="new-password" />
            </div>
            <button id="password-btn" class="btn-secondary">{m.settings_update_password()}</button>
          </div>
        </>
      ) : (
        <p class="text-sm text-zinc-600 dark:text-zinc-300">
          {m.settings_password_sso()}
        </p>
      )}
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_notifications_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-5">
        {m.settings_notifications_description()}
      </p>

      <div class="pb-5 border-b mb-5">
        <label class="label" for="notify-time">{m.settings_notify_time_label()}</label>
        <input id="notify-time" class="input max-w-xs" type="time" />
        <p class="text-xs text-zinc-600 dark:text-zinc-300 mt-2">
          {m.settings_notify_time_help()}
        </p>
        <div id="notify-time-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mt-3"></div>
      </div>

      <div class="space-y-5">
        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="email-enabled" onclick="event.stopPropagation()" />
              {m.settings_email()}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <p class="text-xs text-zinc-600 dark:text-zinc-300 mb-3">{m.settings_sent_to({ email: user.email })}</p>
            <div id="email-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="email">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="email">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="ntfy-enabled" onclick="event.stopPropagation()" />
              ntfy
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="ntfy-server">{m.settings_server()}</label>
                <input id="ntfy-server" class="input" type="text" placeholder="https://ntfy.sh" />
              </div>
              <div>
                <label class="label" for="ntfy-topic">{m.settings_topic()}</label>
                <input id="ntfy-topic" class="input" type="text" placeholder={m.settings_ntfy_topic_placeholder()} />
              </div>
              <div>
                <label class="label" for="ntfy-access-token">{m.settings_access_token_optional()}</label>
                <PasswordInput id="ntfy-access-token" />
              </div>
            </div>
            <div id="ntfy-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="ntfy">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="ntfy">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="discord-enabled" onclick="event.stopPropagation()" />
              Discord
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="max-w-sm mb-3">
              <label class="label" for="discord-webhook-url">{m.settings_webhook_url()}</label>
              <input id="discord-webhook-url" class="input" type="text" placeholder="https://discord.com/api/webhooks/..." />
            </div>
            <div id="discord-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="discord">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="discord">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="telegram-enabled" onclick="event.stopPropagation()" />
              Telegram
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="telegram-bot-token">{m.settings_bot_token()}</label>
                <PasswordInput id="telegram-bot-token" />
              </div>
              <div>
                <label class="label" for="telegram-chat-id">{m.settings_chat_id()}</label>
                <input id="telegram-chat-id" class="input" type="text" />
              </div>
            </div>
            <div id="telegram-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="telegram">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="telegram">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="pushover-enabled" onclick="event.stopPropagation()" />
              Pushover
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="pushover-user-key">{m.settings_user_key()}</label>
                <input id="pushover-user-key" class="input" type="text" />
              </div>
              <div>
                <label class="label" for="pushover-api-token">{m.settings_api_token()}</label>
                <PasswordInput id="pushover-api-token" />
              </div>
            </div>
            <div id="pushover-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="pushover">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="pushover">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" class="toggle" id="gotify-enabled" onclick="event.stopPropagation()" />
              Gotify
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="gotify-server">{m.settings_server()}</label>
                <input id="gotify-server" class="input" type="text" placeholder="https://gotify.example.com" />
              </div>
              <div>
                <label class="label" for="gotify-app-token">{m.settings_app_token()}</label>
                <PasswordInput id="gotify-app-token" />
              </div>
              <div>
                <label class="label" for="gotify-priority">{m.settings_priority_optional()}</label>
                <input id="gotify-priority" class="input" type="number" min="0" max="10" placeholder={m.settings_app_default()} />
              </div>
            </div>
            <div id="gotify-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="gotify">{m.settings_save()}</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="gotify">{m.settings_send_test()}</button>
            </div>
          </div>
        </details>

        <div>
          <h3 class="text-sm font-medium mb-1">{m.settings_device_notifications_title()}</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-300 mb-3" id="webpush-description">
            {m.settings_device_notifications_description()}
          </p>
          <div id="webpush-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
          <div class="flex gap-2">
            <button class="btn-secondary text-xs px-3 py-1.5" id="webpush-toggle-btn">{m.settings_webpush_enable()}</button>
            <button class="btn-ghost text-xs px-3 py-1.5" id="webpush-test-btn" hidden>{m.settings_send_test()}</button>
          </div>
        </div>
      </div>
    </section>

    <section id="shares" class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_shares_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        {m.settings_shares_description()}
      </p>
      <ul id="share-list" class="space-y-1.5"></ul>
      <p id="share-empty" class="hidden text-sm text-zinc-500 dark:text-zinc-400">
        {m.settings_shares_empty_before()} <a href="/calendar" class="font-medium hover:underline">{m.settings_shares_empty_link()}</a> {m.settings_shares_empty_after()}
      </p>
      <div id="share-error" class="hidden text-sm px-3.5 py-2.5 rounded-lg bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"></div>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_import_export_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        {m.settings_import_export_description()}
      </p>
      <div class="flex flex-wrap gap-2 mb-5">
        <a href="/api/data/export?format=csv" download class="btn-secondary">{m.settings_export_csv()}</a>
        <a href="/api/data/export?format=json" download class="btn-secondary">{m.settings_export_json()}</a>
      </div>

      <label
        id="import-drop"
        for="import-file"
        class="flex flex-col items-center justify-center gap-1.5 text-center cursor-pointer rounded-xl border-2 border-dashed px-4 py-8 transition-colors hover:bg-zinc-50 dark:hover:bg-white/5 focus-within:ring-2 focus-within:ring-zinc-900/10 dark:focus-within:ring-white/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
        </svg>
        <span id="import-drop-text" class="text-sm font-medium">{m.settings_import_drop_hint()}</span>
        <span class="text-xs text-zinc-500 dark:text-zinc-400">{m.settings_import_max_size()}</span>
        <input id="import-file" class="sr-only" type="file" accept=".csv,.json,.vcf,text/csv,application/json,text/vcard" />
      </label>
      <button id="import-btn" class="btn-secondary mt-3" disabled>{m.settings_import()}</button>
      <div id="import-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mt-3"></div>
      <ul id="import-errors" class="hidden list-disc pl-5 mt-2 text-xs text-zinc-600 dark:text-zinc-300 space-y-0.5"></ul>

      <details class="mt-4 text-xs text-zinc-600 dark:text-zinc-300">
        <summary class="cursor-pointer">{m.settings_file_format()}</summary>
        <div class="mt-2 space-y-2">
          <p set:html={m.settings_file_format_csv()} />
          <p set:html={m.settings_file_format_json({ example: jsonExample })} />
          <p>{m.settings_file_format_merge()}</p>
        </div>
      </details>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">{m.settings_carddav_title()}</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        {m.settings_carddav_description()}
      </p>
      <div class="space-y-3 max-w-md">
        <div>
          <label class="label" for="carddav-url">{m.settings_carddav_url()}</label>
          <input id="carddav-url" class="input" type="url" placeholder="https://cloud.example.com/remote.php/dav/addressbooks/users/me/contacts/" autocomplete="off" />
        </div>
