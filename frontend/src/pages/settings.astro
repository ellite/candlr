  <script is:inline type="application/json" id="settings-data" set:html={JSON.stringify({ hasPassword: user.has_password, initialChannels: channels, vapidPublicKey, notifyTime, initialCarddav: carddav }).replace(/</g, "\\u003c")}></script>

  <script>
    import * as m from "../paraglide/messages.js";
    import { getLocale } from "../paraglide/runtime.js";

    const { hasPassword, initialChannels, vapidPublicKey, notifyTime, initialCarddav } = JSON.parse(document.getElementById("settings-data").textContent);

    const cadenceLabel = (interval, unit) => {
      const one = { day: m.settings_every_day, week: m.settings_every_week, month: m.settings_every_month, year: m.settings_every_year };
      const many = { day: m.settings_every_n_days, week: m.settings_every_n_weeks, month: m.settings_every_n_months, year: m.settings_every_n_years };
      return interval === 1 ? one[unit]() : many[unit]({ count: interval });
    };
    const formatDateTime = (value) => new Date(value).toLocaleString(getLocale());

    // ── Password change ──
    const pwBtn = document.getElementById("password-btn");
    const pwError = document.getElementById("password-error");
    const pwSuccess = document.getElementById("password-success");

    pwBtn?.addEventListener("click", async () => {
      const currentPassword = document.getElementById("current-password").value;
      const newPassword = document.getElementById("new-password").value;
      const confirmNewPassword = document.getElementById("confirm-new-password").value;

      pwError.classList.add("hidden");
      pwSuccess.classList.add("hidden");

      if (!currentPassword || !newPassword || !confirmNewPassword) return;
      if (newPassword !== confirmNewPassword) {
        pwError.textContent = m.settings_passwords_mismatch();
        pwError.classList.remove("hidden");
        return;
      }

      pwBtn.disabled = true;
      pwBtn.textContent = m.settings_updating();

      try {
        const res = await fetch("/api/auth/change-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = m.settings_password_update_failed();
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        document.getElementById("current-password").value = "";
        document.getElementById("new-password").value = "";
        document.getElementById("confirm-new-password").value = "";
        pwSuccess.textContent = m.settings_password_updated();
        pwSuccess.classList.remove("hidden");
      } catch (e) {
        pwError.textContent = e.message;
        pwError.classList.remove("hidden");
      } finally {
        pwBtn.disabled = false;
        pwBtn.textContent = m.settings_update_password();
      }
    });

    // ── Event types ──
    const eventTypeError = document.getElementById("event-type-error");
    const eventTypeList = document.getElementById("event-type-list");
    const newEventTypeInput = document.getElementById("new-event-type");
    const addEventTypeBtn = document.getElementById("add-event-type-btn");
    const addEventTypeModal = document.getElementById("add-event-type-modal");
    const newEventTypeError = document.getElementById("new-event-type-error");

    const newEventTypeInterval = document.getElementById("new-event-type-interval");
    const newEventTypeUnit = document.getElementById("new-event-type-unit");
    const newEventTypeHint = document.getElementById("new-event-type-hint");

    // Warns that anything but every 1 year / 1 month counts from a full start date.
    function syncNewEventTypeCadence() {
      const interval = Number(newEventTypeInterval.value);
      const needsYear = !(interval === 1 && ["month", "year"].includes(newEventTypeUnit.value));
      newEventTypeHint.classList.toggle("hidden", !needsYear);
      newEventTypeHint.textContent = needsYear
        ? m.settings_cadence_hint()
        : "";
    }
    newEventTypeInterval?.addEventListener("input", syncNewEventTypeCadence);
    newEventTypeUnit?.addEventListener("change", syncNewEventTypeCadence);

    function openAddEventTypeModal() {
      newEventTypeInput.value = "";
      newEventTypeInterval.value = "1";
      newEventTypeUnit.value = "year";
      newEventTypeError.classList.add("hidden");
      syncNewEventTypeCadence();
      addEventTypeModal.classList.remove("hidden");
      newEventTypeInput.focus();
    }

    function closeAddEventTypeModal() {
      if (addEventTypeBtn.disabled) return;
      addEventTypeModal.classList.add("hidden");
    }

    document.getElementById("open-add-event-type-btn")?.addEventListener("click", () => {
      eventTypeError.classList.add("hidden");
      openAddEventTypeModal();
    });
    document.getElementById("add-event-type-cancel-btn")?.addEventListener("click", closeAddEventTypeModal);
    document.getElementById("add-event-type-close-btn")?.addEventListener("click", closeAddEventTypeModal);
    document.getElementById("add-event-type-backdrop")?.addEventListener("click", closeAddEventTypeModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !addEventTypeModal.classList.contains("hidden")) closeAddEventTypeModal();
    });

    function eventTypeRowHtml(et) {
      const name = document.createElement("div");
      name.textContent = et.name;
      const escapedName = name.innerHTML.replace(/"/g, "&quot;").replace(/'/g, "&#39;");
      const cadence = et.interval === 1 && et.unit === "year"
        ? ""
        : `<span class="text-xs text-zinc-500 dark:text-zinc-400 flex-shrink-0">${cadenceLabel(et.interval, et.unit)}</span>`;
      return `
        <li class="flex items-center gap-2 px-2 py-2 rounded-lg bg-stone-50 dark:bg-white/5" data-event-type-id="${et.id}">
          <button type="button" class="icon-button text-zinc-400 dark:text-zinc-500 cursor-grab touch-none flex-shrink-0 p-1" data-drag-handle aria-label="${m.settings_drag_to_reorder()}">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <circle cx="9" cy="6" r="1.4" /><circle cx="9" cy="12" r="1.4" /><circle cx="9" cy="18" r="1.4" />
              <circle cx="15" cy="6" r="1.4" /><circle cx="15" cy="12" r="1.4" /><circle cx="15" cy="18" r="1.4" />
            </svg>
          </button>
          <span class="text-sm flex-1 truncate">${escapedName}</span>
          ${cadence}
          <button type="button" class="icon-button text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 flex-shrink-0 p-1" data-edit-event-type="${et.id}" data-name="${escapedName}" data-interval="${et.interval}" data-unit="${et.unit}" data-is-default="${et.is_default ? "true" : "false"}" title="${m.settings_edit()}" aria-label="${m.settings_edit_named({ name: escapedName })}"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m16 4 4 4M4 20l4-1L20 7a2.12 2.12 0 0 0-3-3L5 16l-1 4Z" /></svg></button>
          ${!et.is_default ? `<button class="icon-button text-zinc-400 hover:text-red-600 dark:hover:text-red-400 flex-shrink-0 p-1" data-delete-event-type="${et.id}" data-name="${escapedName}" title="${m.settings_delete()}" aria-label="${m.settings_delete_named({ name: escapedName })}">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>` : ""}
        </li>`;
    }

    async function addEventType() {
      const name = newEventTypeInput.value.trim();
      newEventTypeError.classList.add("hidden");
      if (!name) {
        newEventTypeError.textContent = m.settings_name_required();
        newEventTypeError.classList.remove("hidden");
        return;
      }
      const interval = Number(newEventTypeInterval.value);
      if (!Number.isInteger(interval) || interval < 1 || interval > 1000) {
        newEventTypeError.textContent = m.settings_interval_invalid();
        newEventTypeError.classList.remove("hidden");
        return;
      }

      addEventTypeBtn.disabled = true;
      try {
        const res = await fetch("/api/event-types", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, interval, unit: newEventTypeUnit.value }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail?.[0]?.msg || data.detail || m.settings_event_type_add_failed());
        }
        const created = await res.json();
        eventTypeList.insertAdjacentHTML("beforeend", eventTypeRowHtml(created));
        addEventTypeBtn.disabled = false;
        closeAddEventTypeModal();
      } catch (e) {
        newEventTypeError.textContent = e.message;
        newEventTypeError.classList.remove("hidden");
      } finally {
        addEventTypeBtn.disabled = false;
      }
    }

    addEventTypeBtn?.addEventListener("click", addEventType);
    for (const input of [newEventTypeInput, newEventTypeInterval]) {
      input?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") addEventType();
      });
    }

    const editModal = document.getElementById("edit-event-type-modal");
    const editName = document.getElementById("edit-event-type-name");
    const editInterval = document.getElementById("edit-event-type-interval");
    const editUnit = document.getElementById("edit-event-type-unit");
    const editError = document.getElementById("edit-event-type-error");
    const editSave = document.getElementById("edit-event-type-save-btn");
    const editHint = document.getElementById("edit-event-type-hint");
    let editTrigger = null;
    function syncEditCadence() {
      editHint.classList.toggle("hidden", Number(editInterval.value) === 1 && ["month", "year"].includes(editUnit.value));
      editHint.textContent = m.settings_cadence_hint();
    }
    editInterval.addEventListener("input", syncEditCadence);
    editUnit.addEventListener("change", syncEditCadence);
    eventTypeList.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-edit-event-type]");
      if (!btn) return;
      editTrigger = btn;
      editName.value = btn.dataset.name;
      editInterval.value = btn.dataset.interval;
      editUnit.value = btn.dataset.unit;
      editError.classList.add("hidden");
      syncEditCadence();
      editModal.classList.remove("hidden");
      editName.focus();
    });
    function closeEditModal() {
      if (editSave.disabled) return;
      editModal.classList.add("hidden");
      editTrigger?.focus();
    }
    for (const id of ["edit-event-type-close-btn", "edit-event-type-cancel-btn", "edit-event-type-backdrop"]) {
      document.getElementById(id).addEventListener("click", closeEditModal);
    }
    editModal.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { e.preventDefault(); closeEditModal(); }
      if (e.key === "Tab") {
        const controls = [...editModal.querySelectorAll("button, input, select, [tabindex]")].filter((el) => !el.disabled && el.tabIndex >= 0 && el.getClientRects().length);
        const first = controls[0], last = controls[controls.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    editSave.addEventListener("click", async () => {
      if (editSave.disabled || !editTrigger) return;
      const name = editName.value.trim();
      const interval = Number(editInterval.value);
      editError.classList.add("hidden");
      if (!name || !Number.isInteger(interval) || interval < 1 || interval > 1000) {
        editError.textContent = !name ? m.settings_name_required() : m.settings_interval_invalid();
        editError.classList.remove("hidden");
        return;
      }
      // Disabling the focused button sends focus to BODY, outside the trap.
      if (document.activeElement === editSave) editName.focus();
      editSave.disabled = true;
      try {
        const res = await fetch(`/api/event-types/${editTrigger.dataset.editEventType}`, {
          method: "PUT", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, interval, unit: editUnit.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.detail?.[0]?.msg || data.detail || m.settings_event_type_update_failed());
        const row = editTrigger.closest("li");
        // Keep all labels and action data synchronized through the shared renderer.
        row.insertAdjacentHTML("beforebegin", eventTypeRowHtml(data));
        editTrigger = row.previousElementSibling.querySelector("[data-edit-event-type]");
        row.remove();
        editSave.disabled = false;
        closeEditModal();
      } catch (e) {
        editError.textContent = e.message || m.settings_event_type_update_failed();
        editError.classList.remove("hidden");
      } finally {
        editSave.disabled = false;
        if (!editModal.classList.contains("hidden") && !editModal.contains(document.activeElement)) {
          editName.focus();
        }
      }
    });

    const deleteEventTypeModal = document.getElementById("delete-event-type-modal");
    const deleteEventTypeName = document.getElementById("delete-event-type-title");
    const deleteEventTypeConfirmBtn = document.getElementById("delete-event-type-confirm-btn");
    let pendingDeleteEventTypeId = null;

    eventTypeList?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-delete-event-type]");
      if (!btn) return;
      pendingDeleteEventTypeId = btn.dataset.deleteEventType;
      deleteEventTypeName.textContent = m.settings_delete_named_title({ name: btn.dataset.name });
      deleteEventTypeModal.classList.remove("hidden");
    });

    function closeDeleteEventTypeModal() {
      deleteEventTypeModal.classList.add("hidden");
      pendingDeleteEventTypeId = null;
    }
    document.getElementById("delete-event-type-cancel-btn")?.addEventListener("click", closeDeleteEventTypeModal);
    document.getElementById("delete-event-type-backdrop")?.addEventListener("click", closeDeleteEventTypeModal);

    deleteEventTypeConfirmBtn?.addEventListener("click", async () => {
      if (!pendingDeleteEventTypeId) return;
      deleteEventTypeConfirmBtn.disabled = true;
      try {
        const res = await fetch(`/api/event-types/${pendingDeleteEventTypeId}`, { method: "DELETE" });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || m.settings_event_type_delete_failed());
        }
        eventTypeList.querySelector(`[data-event-type-id="${pendingDeleteEventTypeId}"]`)?.remove();
        closeDeleteEventTypeModal();
      } catch (e) {
        eventTypeError.textContent = e.message;
        eventTypeError.classList.remove("hidden");
        closeDeleteEventTypeModal();
      } finally {
        deleteEventTypeConfirmBtn.disabled = false;
      }
    });

    // ── Address book sync (CardDAV) ──
    const carddavUrl = document.getElementById("carddav-url");
    const carddavUsername = document.getElementById("carddav-username");
    const carddavPassword = document.getElementById("carddav-password");
    const carddavSaveBtn = document.getElementById("carddav-save-btn");
    const carddavSyncBtn = document.getElementById("carddav-sync-btn");
    const carddavDisconnectBtn = document.getElementById("carddav-disconnect-btn");
    const carddavStatus = document.getElementById("carddav-status");
    const carddavErrors = document.getElementById("carddav-errors");
    const carddavDisconnectModal = document.getElementById("carddav-disconnect-modal");
    const carddavDeleteCards = document.getElementById("carddav-delete-cards");
    const carddavConfirmBtn = document.getElementById("carddav-disconnect-confirm-btn");

    function carddavSay(message, isError) {
      carddavStatus.textContent = message;
      carddavStatus.className = `text-sm px-3.5 py-2.5 rounded-lg mt-3 ${
        isError
          ? "bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"
          : "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
    }

    function carddavClearStatus() {
      carddavStatus.classList.add("hidden");
      carddavErrors.classList.add("hidden");
      carddavErrors.replaceChildren();
    }

    function renderCarddav(account) {
      const connected = !!account;
      carddavSyncBtn.classList.toggle("hidden", !connected);
      carddavDisconnectBtn.classList.toggle("hidden", !connected);
      carddavSaveBtn.textContent = connected ? m.settings_carddav_save_changes() : m.settings_carddav_save_sync();
      carddavPassword.placeholder = account?.has_password ? m.settings_carddav_password_saved() : "";
      carddavClearStatus();
      if (!account) return;
      const result = account.last_result;
      if (account.last_error) {
        const when = account.last_sync_at ? m.settings_carddav_last_sync({ when: formatDateTime(account.last_sync_at) }) : "";
        carddavSay(`${account.last_error}.${when}`.replace(/\.\.$/, "."), true);
      } else if (account.last_sync_at && result) {
        const parts = [(result.cards === 1 ? m.settings_carddav_contacts_one : m.settings_carddav_contacts_other)({ count: result.cards })];
        if (result.added) parts.push(m.settings_carddav_added({ count: result.added }));
        if (result.updated) parts.push(m.settings_carddav_updated({ count: result.updated }));
        if (result.removed) parts.push(m.settings_carddav_removed({ count: result.removed }));
        if (result.skipped) parts.push(m.settings_carddav_skipped({ count: result.skipped }));
        carddavSay(m.settings_carddav_synced({ when: formatDateTime(account.last_sync_at), parts: parts.join(", ") }), false);
      } else {
        carddavSay(m.settings_carddav_connected_unsynced(), false);
      }
      for (const message of result?.errors ?? []) {
        const li = document.createElement("li");
        li.textContent = message;
        carddavErrors.appendChild(li);
      }
      carddavErrors.classList.toggle("hidden", !carddavErrors.children.length);
    }

    async function carddavRequest(path, options) {
      const res = await fetch(`/api/carddav${path}`, options);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.detail?.[0]?.msg || data.detail || m.settings_something_went_wrong());
      return data;
    }

    async function refreshCarddav() {
      renderCarddav(await carddavRequest("", {}).catch(() => initialCarddav));
    }

    async function runCarddavSync() {
      carddavSay(m.settings_carddav_syncing(), false);
      try {
        renderCarddav(await carddavRequest("/sync", { method: "POST" }));
      } catch (e) {
        await refreshCarddav();
        carddavSay(e.message, true);
      }
    }

    function setCarddavBusy(busy) {
      for (const btn of [carddavSaveBtn, carddavSyncBtn, carddavDisconnectBtn]) btn.disabled = busy;
    }

    if (initialCarddav) {
      carddavUrl.value = initialCarddav.url;
      carddavUsername.value = initialCarddav.username;
    }
    renderCarddav(initialCarddav);

    carddavSaveBtn.addEventListener("click", async () => {
      const url = carddavUrl.value.trim();
      if (!url) {
        carddavSay(m.settings_carddav_url_required(), true);
        return;
      }
      setCarddavBusy(true);
      try {
        const body = { url, username: carddavUsername.value.trim() };
        if (carddavPassword.value) body.password = carddavPassword.value;
        const saved = await carddavRequest("", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        carddavPassword.value = "";
        renderCarddav(saved);
        await runCarddavSync();
      } catch (e) {
        carddavSay(e.message, true);
      } finally {
        setCarddavBusy(false);
      }
    });

    carddavSyncBtn.addEventListener("click", async () => {
      setCarddavBusy(true);
      await runCarddavSync();
      setCarddavBusy(false);
    });

    carddavDisconnectBtn.addEventListener("click", () => {
      carddavDeleteCards.checked = false;
      carddavDisconnectModal.classList.remove("hidden");
    });
    function closeCarddavDisconnectModal() {
      if (!carddavConfirmBtn.disabled) carddavDisconnectModal.classList.add("hidden");
    }
    document.getElementById("carddav-disconnect-cancel-btn").addEventListener("click", closeCarddavDisconnectModal);
    document.getElementById("carddav-disconnect-backdrop").addEventListener("click", closeCarddavDisconnectModal);
    carddavConfirmBtn.addEventListener("click", async () => {
      carddavConfirmBtn.disabled = true;
      try {
        const data = await carddavRequest(`?delete_cards=${carddavDeleteCards.checked}`, { method: "DELETE" });
        carddavUrl.value = carddavUsername.value = carddavPassword.value = "";
        renderCarddav(null);
        carddavSay(
          carddavDeleteCards.checked
            ? (data.cards === 1 ? m.settings_carddav_disconnected_deleted_one : m.settings_carddav_disconnected_deleted_other)({ count: data.cards })
            : (data.cards === 1 ? m.settings_carddav_disconnected_kept_one : m.settings_carddav_disconnected_kept_other)({ count: data.cards }),
          false
        );
        carddavConfirmBtn.disabled = false;
        closeCarddavDisconnectModal();
      } catch (e) {
        carddavConfirmBtn.disabled = false;
        closeCarddavDisconnectModal();
        carddavSay(e.message, true);
      }
    });

    // ── Delete account ──
    const modal = document.getElementById("delete-modal");
    const deleteError = document.getElementById("delete-error");
    const deleteBtn = document.getElementById("delete-confirm-btn");

    function openModal() {
      deleteError.classList.add("hidden");
      modal.classList.remove("hidden");
    }
    function closeModal() {
      modal.classList.add("hidden");
    }

    document.getElementById("open-delete-modal")?.addEventListener("click", openModal);
    document.getElementById("delete-cancel-btn")?.addEventListener("click", closeModal);
    document.getElementById("delete-modal-backdrop")?.addEventListener("click", closeModal);

    deleteBtn?.addEventListener("click", async () => {
      const password = hasPassword ? document.getElementById("delete-password")?.value : undefined;
      if (hasPassword && !password) {
        deleteError.textContent = m.settings_enter_password_confirm();
        deleteError.classList.remove("hidden");
        return;
      }

      deleteBtn.disabled = true;
      deleteBtn.textContent = m.settings_deleting();

      try {
        const res = await fetch("/api/auth/me", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = m.settings_account_delete_failed();
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        window.location.href = "/login";
      } catch (e) {
        deleteError.textContent = e.message;
        deleteError.classList.remove("hidden");
        deleteBtn.disabled = false;
        deleteBtn.textContent = m.settings_delete_account();
      }
    });

    // ── Delete all events ──
    const eventsModal = document.getElementById("delete-events-modal");
    const deleteEventsError = document.getElementById("delete-events-error");
    const deleteEventsBtn = document.getElementById("delete-events-confirm-btn");

    function openEventsModal() {
      deleteEventsError.classList.add("hidden");
      eventsModal.classList.remove("hidden");
    }
    function closeEventsModal() {
      eventsModal.classList.add("hidden");
    }

    document.getElementById("open-delete-events-modal")?.addEventListener("click", openEventsModal);
    document.getElementById("delete-events-cancel-btn")?.addEventListener("click", closeEventsModal);
    document.getElementById("delete-events-modal-backdrop")?.addEventListener("click", closeEventsModal);

    deleteEventsBtn?.addEventListener("click", async () => {
      const password = hasPassword ? document.getElementById("delete-events-password")?.value : undefined;
      if (hasPassword && !password) {
        deleteEventsError.textContent = m.settings_enter_password_confirm();
        deleteEventsError.classList.remove("hidden");
        return;
      }

      deleteEventsBtn.disabled = true;
      deleteEventsBtn.textContent = m.settings_deleting();

      try {
        const res = await fetch("/api/people", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = m.settings_events_delete_failed();
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        window.location.href = "/";
      } catch (e) {
        deleteEventsError.textContent = e.message;
        deleteEventsError.classList.remove("hidden");
        deleteEventsBtn.disabled = false;
        deleteEventsBtn.textContent = m.settings_delete_all_events();
      }
    });

    // ── Import ──
    const importFile = document.getElementById("import-file");
    const importBtn = document.getElementById("import-btn");
    const importStatus = document.getElementById("import-status");
    const importErrors = document.getElementById("import-errors");
    const importDrop = document.getElementById("import-drop");
    const importDropText = document.getElementById("import-drop-text");
    const IMPORT_DROP_HINT = importDropText.textContent;
    // Highlight with background + ring, not border color: global.css sets
    // border-color on `*` unlayered, which beats any border-color utility.
    const DRAG_CLASSES = ["bg-zinc-100", "dark:bg-white/10", "ring-2", "ring-zinc-900/20", "dark:ring-white/25"];

    function syncImportFile() {
      const file = importFile.files?.[0];
      importDropText.textContent = file ? file.name : IMPORT_DROP_HINT;
      importBtn.disabled = !file;
    }

    importFile.addEventListener("change", syncImportFile);

    // Counter, not a boolean: dragenter/dragleave also fire for every child
    // element the pointer crosses, which would make the highlight flicker.
    let dragDepth = 0;
    importDrop.addEventListener("dragenter", (e) => {
      e.preventDefault();
      dragDepth++;
      importDrop.classList.add(...DRAG_CLASSES);
    });
    importDrop.addEventListener("dragover", (e) => e.preventDefault());
    importDrop.addEventListener("dragleave", () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) importDrop.classList.remove(...DRAG_CLASSES);
    });
    importDrop.addEventListener("drop", (e) => {
      e.preventDefault();
      dragDepth = 0;
      importDrop.classList.remove(...DRAG_CLASSES);
      const file = e.dataTransfer?.files?.[0];
      if (!file) return;
      const transfer = new DataTransfer();
      transfer.items.add(file);
      importFile.files = transfer.files;
      syncImportFile();
    });

    function showImportStatus(message, isError) {
      importStatus.textContent = message;
      importStatus.className = `text-sm px-3.5 py-2.5 rounded-lg mt-3 ${
        isError
          ? "bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"
          : "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
    }

    const count = (n, one, other) => (n === 1 ? one : other)({ count: n });

    importBtn?.addEventListener("click", async () => {
      const file = importFile.files?.[0];
      importErrors.classList.add("hidden");
      importErrors.replaceChildren();
      if (!file) {
        showImportStatus(m.settings_import_choose_file(), true);
        return;
      }

      importBtn.disabled = true;
      importBtn.textContent = m.settings_importing();
      try {
        const form = new FormData();
        form.append("file", file);
        const res = await fetch("/api/data/import", { method: "POST", body: form });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.detail || m.settings_import_failed());

        const parts = [count(data.events_added, m.settings_import_dates_added_one, m.settings_import_dates_added_other)];
        if (data.people_created) parts.push(count(data.people_created, m.settings_import_new_cards_one, m.settings_import_new_cards_other));
        if (data.event_types_created) parts.push(count(data.event_types_created, m.settings_import_new_event_types_one, m.settings_import_new_event_types_other));
        if (data.events_skipped) parts.push(count(data.events_skipped, m.settings_import_duplicates_one, m.settings_import_duplicates_other));
        if (data.invalid_rows) parts.push(count(data.invalid_rows, m.settings_import_invalid_rows_one, m.settings_import_invalid_rows_other));
        showImportStatus(m.settings_import_done({ parts: parts.join(", ") }), false);

        for (const message of data.errors) {
          const li = document.createElement("li");
          li.textContent = message;
          importErrors.appendChild(li);
        }
        if (data.errors.length) importErrors.classList.remove("hidden");
        if (data.event_types_created) {
          // The event type list above is rendered from page load data.
          setTimeout(() => window.location.reload(), data.errors.length ? 6000 : 1500);
        }
        importFile.value = "";
      } catch (e) {
        showImportStatus(e.message, true);
      } finally {
        syncImportFile();
        importBtn.textContent = m.settings_import();
      }
    });

    // ── Notification channels ──
    const CHANNEL_FIELDS = {
      email: [],
      ntfy: ["server", "topic", "access_token"],
      discord: ["webhook_url"],
      telegram: ["bot_token", "chat_id"],
      pushover: ["user_key", "api_token"],
      gotify: ["server", "app_token", "priority"],
    };

    function fieldId(channel, field) {
      return `${channel}-${field.replace(/_/g, "-")}`;
    }

    function showStatus(channel, message, isError) {
      const el = document.getElementById(`${channel}-status`);
      if (!el) return;
      el.textContent = message;
      el.className = `text-sm px-3.5 py-2.5 rounded-lg mb-3 ${
        isError
          ? "bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"
          : "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
    }

    for (const c of initialChannels) {
      if (c.channel === "webpush") continue;
      const checkbox = document.getElementById(`${c.channel}-enabled`);
      if (checkbox) checkbox.checked = c.enabled;
      for (const field of CHANNEL_FIELDS[c.channel] || []) {
        const el = document.getElementById(fieldId(c.channel, field));
        if (el && c.config[field] !== undefined) el.value = c.config[field];
      }
    }

    const notifyTimeInput = document.getElementById("notify-time");
    notifyTimeInput.value = notifyTime;
    notifyTimeInput.addEventListener("change", async () => {
      if (!notifyTimeInput.value) return;
      try {
        const res = await fetch("/api/notifications/preferences", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ notify_time: notifyTimeInput.value }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || m.settings_save_failed());
        }
        showStatus("notify-time", m.settings_saved(), false);
      } catch (e) {
        showStatus("notify-time", e.message, true);
      }
    });

    async function saveChannel(channel) {
      const enabled = document.getElementById(`${channel}-enabled`).checked;
      const config = {};
      for (const field of CHANNEL_FIELDS[channel] || []) {
        const el = document.getElementById(fieldId(channel, field));
        if (el) config[field] = el.value.trim();
      }
      try {
        const res = await fetch(`/api/notifications/channels/${channel}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ enabled, config }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || m.settings_save_failed());
        }
        showStatus(channel, m.settings_saved(), false);
      } catch (e) {
        showStatus(channel, e.message, true);
      }
    }

    async function testChannel(channel) {
      try {
        const res = await fetch(`/api/notifications/channels/${channel}/test`, { method: "POST" });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || m.settings_test_failed());
        }
        showStatus(channel, m.settings_test_sent(), false);
      } catch (e) {
        showStatus(channel, e.message, true);
      }
    }

    document.querySelectorAll("[data-save]").forEach((btn) => {
      btn.addEventListener("click", () => saveChannel(btn.dataset.save));
    });
    document.querySelectorAll("[data-test]").forEach((btn) => {
      btn.addEventListener("click", () => testChannel(btn.dataset.test));
    });

    // ── Device (web push) notifications ──
    function urlBase64ToUint8Array(base64String) {
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const rawData = atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    const webpushToggleBtn = document.getElementById("webpush-toggle-btn");
    const webpushTestBtn = document.getElementById("webpush-test-btn");
    const webpushDescription = document.getElementById("webpush-description");

    async function getExistingSubscription() {
      if (!("serviceWorker" in navigator) || !("PushManager" in window)) return null;
      const reg = await navigator.serviceWorker.getRegistration().catch(() => null);
      if (!reg) return null;
      return reg.pushManager.getSubscription();
    }

    async function refreshWebpushUI() {
      if (!vapidPublicKey) {
        webpushDescription.textContent = m.settings_webpush_not_configured();
        webpushToggleBtn.disabled = true;
        return;
      }
      if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
        webpushDescription.textContent = m.settings_webpush_unsupported();
        webpushToggleBtn.disabled = true;
        return;
      }
      const sub = await getExistingSubscription();
      webpushToggleBtn.textContent = sub ? m.settings_webpush_disable() : m.settings_webpush_enable();
      webpushTestBtn.hidden = !sub;
    }

    webpushToggleBtn?.addEventListener("click", async () => {
      webpushToggleBtn.disabled = true;
      try {
        const existing = await getExistingSubscription();
        if (existing) {
          await fetch("/api/notifications/webpush/unsubscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ endpoint: existing.endpoint }),
          });
          await existing.unsubscribe();
          showStatus("webpush", m.settings_webpush_disabled(), false);
        } else {
          const permission = await Notification.requestPermission();
          if (permission !== "granted") {
            throw new Error(m.settings_webpush_permission_denied());
          }
          const reg = await navigator.serviceWorker.register("/sw.js");
          await navigator.serviceWorker.ready;
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
          const subJson = sub.toJSON();
          const res = await fetch("/api/notifications/webpush/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ endpoint: subJson.endpoint, keys: subJson.keys }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.detail || m.settings_webpush_subscribe_failed());
          }
          showStatus("webpush", m.settings_webpush_enabled(), false);
        }
      } catch (e) {
        showStatus("webpush", e.message, true);
      } finally {
        webpushToggleBtn.disabled = false;
        refreshWebpushUI();
      }
    });

    webpushTestBtn?.addEventListener("click", () => testChannel("webpush"));

    refreshWebpushUI();
  </script>

  <script>
    import * as m from "../paraglide/messages.js";
    import { initDragReorder } from "../lib/dragReorder.js";
    import { enhanceSelects } from "../lib/customSelect.js";

    // Swaps the native unit select in the add-event-type sheet for the app's
    // styled dropdown (the native one is visually hidden by .select).
    enhanceSelects();

    const eventTypeList = document.getElementById("event-type-list");
    if (eventTypeList) {
      initDragReorder(eventTypeList, {
        onReorder: async (ids) => {
          const res = await fetch("/api/event-types/reorder", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids: ids.map(Number) }),
          });
          if (!res.ok) {
            const errorEl = document.getElementById("event-type-error");
            errorEl.textContent = m.settings_reorder_failed();
            errorEl.classList.remove("hidden");
          }
        },
      });
    }
  </script>

  <script>
    import * as m from "../paraglide/messages.js";
    import { copyText, listShares, shareUrl } from "../lib/shares.js";
    import { lockScroll, unlockScroll } from "../lib/scrollLock.js";
    import { showToast } from "../lib/toast.js";

    const shareList = document.getElementById("share-list");
    const shareEmpty = document.getElementById("share-empty");
    const shareError = document.getElementById("share-error");

    function shareRow(share) {
      const li = document.createElement("li");
      li.className = "rounded-lg bg-stone-50 dark:bg-white/5";
      const header = document.createElement("div");
      header.className = "flex items-center gap-2 pr-2 py-1.5";

      // The whole name area toggles the settings below it.
      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.setAttribute("aria-expanded", "false");
      toggle.className = "flex items-center gap-2 flex-1 min-w-0 px-3 py-2 text-left";
      toggle.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>`;
      const name = document.createElement("span");
      name.className = "text-sm font-medium truncate";
      name.textContent = share.name;
      toggle.append(name);
      const chevron = toggle.firstElementChild;

      const details = document.createElement("dl");
      details.className = "hidden px-3 pt-2 pb-3 pl-9 space-y-2 text-sm";
      const detailRow = (label, valueEl) => {
        const row = document.createElement("div");
        row.className = "flex items-start justify-between gap-4";
        const dt = document.createElement("dt");
        dt.className = "text-zinc-600 dark:text-zinc-300 flex-shrink-0";
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.className = "text-right min-w-0";
        dd.append(valueEl);
        row.append(dt, dd);
        return row;
      };
      const chips = document.createElement("div");
      chips.className = "flex flex-wrap justify-end gap-1";
      for (const t of share.event_types) {
        const chip = document.createElement("span");
        chip.className = "text-xs px-2 py-0.5 rounded-full bg-zinc-200 dark:bg-zinc-700";
        chip.textContent = t.name;
        chips.append(chip);
      }
      if (!share.event_types.length) chips.textContent = m.settings_share_none();
      const yesNo = (on) => {
        const el = document.createElement("span");
        el.textContent = on ? m.settings_share_shown() : m.settings_share_hidden();
        el.className = on ? "font-medium" : "text-zinc-500 dark:text-zinc-400";
        return el;
      };
      details.append(
        detailRow(m.settings_share_event_types(), chips),
        detailRow(m.settings_share_photos(), yesNo(share.show_photos)),
        detailRow(m.settings_share_ages(), yesNo(share.show_ages)),
        detailRow(m.settings_share_addresses(), yesNo(share.show_addresses)),
      );
      toggle.addEventListener("click", () => {
        const open = details.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(open));
        chevron.classList.toggle("rotate-90", open);
      });

      const iconButton = (label, hoverClass, path) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `icon-button inline-flex items-center justify-center border bg-white dark:bg-white/5 hover:bg-zinc-50 dark:hover:bg-white/10 text-zinc-500 dark:text-zinc-400 ${hoverClass} flex-shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-lg transition-colors`;
        btn.title = label;
        btn.setAttribute("aria-label", label);
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px] block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="${path}" /></svg>`;
        return btn;
      };

      const copy = iconButton(
        m.settings_share_copy_link(),
        "hover:text-zinc-900 dark:hover:text-white",
        "M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z",
      );
      copy.addEventListener("click", async () => {
        const probe = Object.assign(document.createElement("input"), { value: shareUrl(share.token) });
        document.body.appendChild(probe);
        const ok = await copyText(probe.value, probe);
        probe.remove();
        showToast(ok ? m.settings_share_link_copied() : m.settings_share_copy_failed(), ok ? "success" : "error");
      });

      // Deleting breaks the link for everyone who has it, so it asks first.
      const del = iconButton(
        m.settings_delete(),
        "hover:text-red-600 dark:hover:text-red-400",
        "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16",
      );
      del.addEventListener("click", () => openDeleteShare(share, li));

      header.append(toggle, copy, del);
      li.append(header, details);
      return li;
    }

    // ── Delete confirmation ──
    const deleteShareModal = document.getElementById("delete-share-modal");
    const deleteShareName = document.getElementById("delete-share-title");
    const deleteShareConfirm = document.getElementById("delete-share-confirm-btn");
    let pendingDelete = null;

    function openDeleteShare(share, row) {
      pendingDelete = { share, row };
      deleteShareName.textContent = m.settings_delete_named_title({ name: share.name });
      const wasHidden = deleteShareModal.classList.contains("hidden");
      deleteShareModal.classList.remove("hidden");
      if (wasHidden) lockScroll();
      deleteShareConfirm.focus();
    }

    function closeDeleteShare() {
      const wasVisible = !deleteShareModal.classList.contains("hidden");
      deleteShareModal.classList.add("hidden");
      pendingDelete = null;
      if (wasVisible) unlockScroll();
    }

    deleteShareConfirm.addEventListener("click", async () => {
      if (!pendingDelete) return;
      const { share, row } = pendingDelete;
      deleteShareConfirm.disabled = true;
      try {
        const res = await fetch(`/api/shares/${share.id}`, { method: "DELETE" });
        if (!res.ok) throw new Error(m.settings_share_delete_failed());
        row.remove();
        if (!shareList.children.length) shareEmpty.classList.remove("hidden");
        showToast(m.settings_share_deleted());
      } catch (e) {
        showToast(e.message, "error");
      } finally {
        deleteShareConfirm.disabled = false;
        closeDeleteShare();
      }
    });
    document.getElementById("delete-share-cancel-btn").addEventListener("click", closeDeleteShare);
    document.getElementById("delete-share-backdrop").addEventListener("click", closeDeleteShare);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !deleteShareModal.classList.contains("hidden")) closeDeleteShare();
    });

    // Loaded client-side rather than at render so the links (the secret) are
    // not baked into the service worker's cached copy of this page.
    listShares()
      .then((shares) => {
        shareList.replaceChildren(...shares.map(shareRow));
        shareEmpty.classList.toggle("hidden", shares.length > 0);
      })
      .catch((e) => {
        shareError.textContent = e.message;
        shareError.classList.remove("hidden");
      });
  </script>
</Layout>
