---
import Layout from "../layouts/Layout.astro";
import TwoFactorSettings from "../components/TwoFactorSettings.astro";
import PasswordInput from "../components/PasswordInput.astro";
import { apiJson } from "../lib/api";

const cookies = Astro.request.headers.get("cookie") ?? "";

type EventType = { id: number; name: string; is_default: boolean };
type NotificationChannel = { channel: string; enabled: boolean; config: Record<string, string> };

// Fired concurrently - see the same comment in index.astro. This page was
// the worst offender, four calls in series before this.
const [meResult, eventTypesResult, channelsResult, vapidResult, notifyPreferencesResult] = await Promise.allSettled([
  apiJson<{ username: string; email: string; has_password: boolean; is_admin: boolean }>("/auth/me", { cookies }),
  apiJson<EventType[]>("/event-types", { cookies }),
  apiJson<NotificationChannel[]>("/notifications/channels", { cookies }),
  apiJson<{ public_key: string | null }>("/notifications/webpush/public-key", { cookies }),
  apiJson<{ notify_time: string }>("/notifications/preferences", { cookies }),
]);

if (meResult.status === "rejected") {
  Astro.cookies.delete("candlr_token", { path: "/" });
  return Astro.redirect("/login");
}
const user = meResult.value;
const eventTypes = eventTypesResult.status === "fulfilled" ? eventTypesResult.value : [];
const channels = channelsResult.status === "fulfilled" ? channelsResult.value : [];
const vapidPublicKey = vapidResult.status === "fulfilled" ? vapidResult.value.public_key : null;
const jsonExample = '{"people": [{"name": "Alex", "events": [{"type": "Birthday", "month": 3, "day": 5, "year": 1990}]}]}';
const notifyTime = notifyPreferencesResult.status === "fulfilled" ? notifyPreferencesResult.value.notify_time : "09:00";
---

<Layout title="Settings" user={{ username: user.username, is_admin: user.is_admin }} activePage="settings">
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-10 space-y-6">
    <div>
      <h1 class="text-lg font-semibold tracking-tight">Settings</h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mt-1">Manage your account.</p>
    </div>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-4">Account</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-zinc-600 dark:text-zinc-300">Username</dt>
          <dd class="font-medium">{user.username}</dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-zinc-600 dark:text-zinc-300">Email</dt>
          <dd class="font-medium">{user.email}</dd>
        </div>
      </dl>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">Events</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        The kinds of dates you can track. Birthday and Anniversary are built in and cannot be deleted. Add your own too.
      </p>

      <ul id="event-type-list" class="space-y-1.5 mb-4">
        {eventTypes.map((et) => (
          <li class="flex items-center gap-2 px-2 py-2 rounded-lg bg-stone-50 dark:bg-white/5" data-event-type-id={et.id}>
            <button
              type="button"
              class="text-zinc-400 dark:text-zinc-500 cursor-grab touch-none flex-shrink-0 p-1"
              data-drag-handle
              aria-label="Drag to reorder"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="9" cy="6" r="1.4" /><circle cx="9" cy="12" r="1.4" /><circle cx="9" cy="18" r="1.4" />
                <circle cx="15" cy="6" r="1.4" /><circle cx="15" cy="12" r="1.4" /><circle cx="15" cy="18" r="1.4" />
              </svg>
            </button>
            <span class="text-sm flex-1 truncate">{et.name}</span>
            {!et.is_default && <button
              class="text-xs text-zinc-400 hover:text-red-600 dark:hover:text-red-400 flex-shrink-0 p-1"
              data-delete-event-type={et.id}
              data-name={et.name}
              title="Delete"
              aria-label={`Delete ${et.name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>}
          </li>
        ))}
      </ul>

      <div id="event-type-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
      <div class="flex gap-2 max-w-sm">
        <input id="new-event-type" class="input" type="text" placeholder="e.g. Graduation" maxlength="64" />
        <button id="add-event-type-btn" class="btn-secondary flex-shrink-0">Add</button>
      </div>
    </section>

    <TwoFactorSettings hasPassword={user.has_password} />

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">Password</h2>
      {user.has_password ? (
        <>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">Change the password you use to sign in.</p>
          <div id="password-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
          <div id="password-success" class="hidden bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
          <div class="space-y-4 max-w-sm">
            <div>
              <label class="label" for="current-password">Current password</label>
              <PasswordInput id="current-password" autocomplete="current-password" />
            </div>
            <div>
              <label class="label" for="new-password">New password</label>
              <PasswordInput id="new-password" autocomplete="new-password" />
            </div>
            <div>
              <label class="label" for="confirm-new-password">Confirm new password</label>
              <PasswordInput id="confirm-new-password" autocomplete="new-password" />
            </div>
            <button id="password-btn" class="btn-secondary">Update password</button>
          </div>
        </>
      ) : (
        <p class="text-sm text-zinc-600 dark:text-zinc-300">
          You sign in through SSO, so there's no password on this account.
        </p>
      )}
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">Notifications</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-5">
        Set up a channel to get reminders on the day of a birthday or anniversary.
        Click a channel to configure it.
      </p>

      <div class="pb-5 border-b mb-5">
        <label class="label" for="notify-time">When to notify</label>
        <input id="notify-time" class="input max-w-xs" type="time" />
        <p class="text-xs text-zinc-600 dark:text-zinc-300 mt-2">
          The time of day, in your instance's configured timezone, to send a reminder on the day
          of any date with notifications turned on. Applies across every enabled channel.
        </p>
        <div id="notify-time-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mt-3"></div>
      </div>

      <div class="space-y-5">
        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="email-enabled" onclick="event.stopPropagation()" />
              Email
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <p class="text-xs text-zinc-600 dark:text-zinc-300 mb-3">Sent to {user.email}</p>
            <div id="email-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="email">Save</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="email">Send test</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="ntfy-enabled" onclick="event.stopPropagation()" />
              ntfy
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="ntfy-server">Server</label>
                <input id="ntfy-server" class="input" type="text" placeholder="https://ntfy.sh" />
              </div>
              <div>
                <label class="label" for="ntfy-topic">Topic</label>
                <input id="ntfy-topic" class="input" type="text" placeholder="a hard-to-guess topic name" />
              </div>
              <div>
                <label class="label" for="ntfy-access-token">Access token (optional)</label>
                <PasswordInput id="ntfy-access-token" />
              </div>
            </div>
            <div id="ntfy-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="ntfy">Save</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="ntfy">Send test</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="discord-enabled" onclick="event.stopPropagation()" />
              Discord
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="max-w-sm mb-3">
              <label class="label" for="discord-webhook-url">Webhook URL</label>
              <input id="discord-webhook-url" class="input" type="text" placeholder="https://discord.com/api/webhooks/..." />
            </div>
            <div id="discord-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="discord">Save</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="discord">Send test</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="telegram-enabled" onclick="event.stopPropagation()" />
              Telegram
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="telegram-bot-token">Bot token</label>
                <PasswordInput id="telegram-bot-token" />
              </div>
              <div>
                <label class="label" for="telegram-chat-id">Chat ID</label>
                <input id="telegram-chat-id" class="input" type="text" />
              </div>
            </div>
            <div id="telegram-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="telegram">Save</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="telegram">Send test</button>
            </div>
          </div>
        </details>

        <details class="group pb-5 border-b">
          <summary class="flex items-center justify-between gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" id="pushover-enabled" onclick="event.stopPropagation()" />
              Pushover
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pt-3">
            <div class="space-y-3 max-w-sm mb-3">
              <div>
                <label class="label" for="pushover-user-key">User key</label>
                <input id="pushover-user-key" class="input" type="text" />
              </div>
              <div>
                <label class="label" for="pushover-api-token">API token</label>
                <PasswordInput id="pushover-api-token" />
              </div>
            </div>
            <div id="pushover-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
            <div class="flex gap-2">
              <button class="btn-secondary text-xs px-3 py-1.5" data-save="pushover">Save</button>
              <button class="btn-ghost text-xs px-3 py-1.5" data-test="pushover">Send test</button>
            </div>
          </div>
        </details>

        <div>
          <h3 class="text-sm font-medium mb-1">Device notifications</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-300 mb-3" id="webpush-description">
            Get notifications on this device, even when Candlr isn't open in a tab.
          </p>
          <div id="webpush-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mb-3"></div>
          <div class="flex gap-2">
            <button class="btn-secondary text-xs px-3 py-1.5" id="webpush-toggle-btn">Enable on this device</button>
            <button class="btn-ghost text-xs px-3 py-1.5" id="webpush-test-btn" hidden>Send test</button>
          </div>
        </div>
      </div>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">Import and export</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        Download every card and date as a file, or add cards from one. Photos are not included.
      </p>
      <div class="flex flex-wrap gap-2 mb-5">
        <a href="/api/data/export?format=csv" download class="btn-secondary">Export CSV</a>
        <a href="/api/data/export?format=json" download class="btn-secondary">Export JSON</a>
      </div>

      <label
        id="import-drop"
        for="import-file"
        class="flex flex-col items-center justify-center gap-1.5 text-center cursor-pointer rounded-xl border-2 border-dashed px-4 py-8 transition-colors hover:bg-zinc-50 dark:hover:bg-white/5 focus-within:ring-2 focus-within:ring-zinc-900/10 dark:focus-within:ring-white/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
        </svg>
        <span id="import-drop-text" class="text-sm font-medium">Drop a CSV or JSON file here, or click to choose</span>
        <span class="text-xs text-zinc-500 dark:text-zinc-400">Up to 2 MB</span>
        <input id="import-file" class="sr-only" type="file" accept=".csv,.json,text/csv,application/json" />
      </label>
      <button id="import-btn" class="btn-secondary mt-3" disabled>Import</button>
      <div id="import-status" class="hidden text-sm px-3.5 py-2.5 rounded-lg mt-3"></div>
      <ul id="import-errors" class="hidden list-disc pl-5 mt-2 text-xs text-zinc-600 dark:text-zinc-300 space-y-0.5"></ul>

      <details class="mt-4 text-xs text-zinc-600 dark:text-zinc-300">
        <summary class="cursor-pointer">File format</summary>
        <div class="mt-2 space-y-2">
          <p>
            CSV has one row per date with the columns <code>name, type, month, day, year, notes, notify</code>.
            Rows with the same name become one card. <code>year</code> and <code>notes</code> can be blank,
            and a <code>date</code> column (<code>1990-04-12</code> or <code>04-12</code>) can replace
            <code>month</code>, <code>day</code> and <code>year</code>. A blank <code>type</code> uses your first event type.
          </p>
          <p>
            JSON is the same data grouped by person: <code set:text={jsonExample} />.
          </p>
          <p>
            Importing merges into what you already have. A name that matches an existing card only gains the dates
            it is missing, and event types that don't exist yet are created, so importing an export twice changes nothing.
          </p>
        </div>
      </details>
    </section>

    <section class="card p-6">
      <h2 class="text-sm font-medium mb-1">Data management</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        Permanently deletes every person and date you're tracking. Your account and settings are kept. This cannot be undone.
      </p>
      <button id="open-delete-events-modal" class="text-sm font-medium text-red-600 dark:text-red-400 hover:underline">
        Delete all my events
      </button>
    </section>

    <section class="card p-6 border-red-200 dark:border-red-900/50">
      <h2 class="text-sm font-medium mb-1 text-red-600 dark:text-red-400">Danger zone</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        Permanently delete your account and all of its data. This cannot be undone.
      </p>
      <button id="open-delete-modal" class="text-sm font-medium text-red-600 dark:text-red-400 hover:underline">
        Delete my account
      </button>
    </section>
  </main>

  <div id="delete-event-type-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div id="delete-event-type-backdrop" class="absolute inset-0 bg-black/40"></div>
    <div class="relative card p-6 w-full max-w-sm">
      <h2 class="text-base font-semibold mb-1.5">Delete <span id="delete-event-type-name"></span>?</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        This also deletes every date tracked under this type. This cannot be undone.
      </p>
      <div class="flex gap-2 justify-end">
        <button id="delete-event-type-cancel-btn" type="button" class="btn-secondary">Cancel</button>
        <button id="delete-event-type-confirm-btn" type="button"
          class="text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
          Delete
        </button>
      </div>
    </div>
  </div>

  <div id="delete-events-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div id="delete-events-modal-backdrop" class="absolute inset-0 bg-black/40"></div>
    <div class="relative card p-6 w-full max-w-sm">
      <h2 class="text-base font-semibold mb-1.5">Delete all events?</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        This permanently deletes every person and date you're tracking. Your account and settings are kept. This cannot be undone.
      </p>
      <div id="delete-events-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
      {user.has_password && (
        <div class="mb-4">
          <label class="label" for="delete-events-password">Confirm your password</label>
          <PasswordInput id="delete-events-password" autocomplete="current-password" />
        </div>
      )}
      <div class="flex gap-2 justify-end">
        <button id="delete-events-cancel-btn" type="button" class="btn-secondary">Cancel</button>
        <button id="delete-events-confirm-btn" type="button"
          class="text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
          Delete all events
        </button>
      </div>
    </div>
  </div>

  <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div id="delete-modal-backdrop" class="absolute inset-0 bg-black/40"></div>
    <div class="relative card p-6 w-full max-w-sm">
      <h2 class="text-base font-semibold mb-1.5">Delete account?</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        This permanently deletes your account and all of its data. This cannot be undone.
      </p>
      <div id="delete-error" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg mb-4"></div>
      {user.has_password && (
        <div class="mb-4">
          <label class="label" for="delete-password">Confirm your password</label>
          <PasswordInput id="delete-password" autocomplete="current-password" />
        </div>
      )}
      <div class="flex gap-2 justify-end">
        <button id="delete-cancel-btn" type="button" class="btn-secondary">Cancel</button>
        <button id="delete-confirm-btn" type="button"
          class="text-sm font-medium px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white transition-colors">
          Delete account
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ hasPassword: user.has_password, initialChannels: channels, vapidPublicKey, notifyTime }}>
    // ── Password change ──
    const pwBtn = document.getElementById("password-btn");
    const pwError = document.getElementById("password-error");
    const pwSuccess = document.getElementById("password-success");

    pwBtn?.addEventListener("click", async () => {
      const currentPassword = document.getElementById("current-password").value;
      const newPassword = document.getElementById("new-password").value;
      const confirmNewPassword = document.getElementById("confirm-new-password").value;

      pwError.classList.add("hidden");
      pwSuccess.classList.add("hidden");

      if (!currentPassword || !newPassword || !confirmNewPassword) return;
      if (newPassword !== confirmNewPassword) {
        pwError.textContent = "New passwords do not match";
        pwError.classList.remove("hidden");
        return;
      }

      pwBtn.disabled = true;
      pwBtn.textContent = "Updating…";

      try {
        const res = await fetch("/api/auth/change-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not update password";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        document.getElementById("current-password").value = "";
        document.getElementById("new-password").value = "";
        document.getElementById("confirm-new-password").value = "";
        pwSuccess.textContent = "Password updated.";
        pwSuccess.classList.remove("hidden");
      } catch (e) {
        pwError.textContent = e.message;
        pwError.classList.remove("hidden");
      } finally {
        pwBtn.disabled = false;
        pwBtn.textContent = "Update password";
      }
    });

    // ── Event types ──
    const eventTypeError = document.getElementById("event-type-error");
    const eventTypeList = document.getElementById("event-type-list");
    const newEventTypeInput = document.getElementById("new-event-type");
    const addEventTypeBtn = document.getElementById("add-event-type-btn");

    function eventTypeRowHtml(et) {
      const name = document.createElement("div");
      name.textContent = et.name;
      return `
        <li class="flex items-center gap-2 px-2 py-2 rounded-lg bg-stone-50 dark:bg-white/5" data-event-type-id="${et.id}">
          <button type="button" class="text-zinc-400 dark:text-zinc-500 cursor-grab touch-none flex-shrink-0 p-1" data-drag-handle aria-label="Drag to reorder">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <circle cx="9" cy="6" r="1.4" /><circle cx="9" cy="12" r="1.4" /><circle cx="9" cy="18" r="1.4" />
              <circle cx="15" cy="6" r="1.4" /><circle cx="15" cy="12" r="1.4" /><circle cx="15" cy="18" r="1.4" />
            </svg>
          </button>
          <span class="text-sm flex-1 truncate">${name.innerHTML}</span>
          ${!et.is_default ? `<button class="text-xs text-zinc-400 hover:text-red-600 dark:hover:text-red-400 flex-shrink-0 p-1" data-delete-event-type="${et.id}" data-name="${name.innerHTML}" title="Delete" aria-label="Delete ${name.innerHTML}">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>` : ""}
        </li>`;
    }

    async function addEventType() {
      const name = newEventTypeInput.value.trim();
      eventTypeError.classList.add("hidden");
      if (!name) return;

      addEventTypeBtn.disabled = true;
      try {
        const res = await fetch("/api/event-types", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || "Could not add event type");
        }
        const created = await res.json();
        eventTypeList.insertAdjacentHTML("beforeend", eventTypeRowHtml(created));
        newEventTypeInput.value = "";
      } catch (e) {
        eventTypeError.textContent = e.message;
        eventTypeError.classList.remove("hidden");
      } finally {
        addEventTypeBtn.disabled = false;
      }
    }

    addEventTypeBtn?.addEventListener("click", addEventType);
    newEventTypeInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") addEventType();
    });

    const deleteEventTypeModal = document.getElementById("delete-event-type-modal");
    const deleteEventTypeName = document.getElementById("delete-event-type-name");
    const deleteEventTypeConfirmBtn = document.getElementById("delete-event-type-confirm-btn");
    let pendingDeleteEventTypeId = null;

    eventTypeList?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-delete-event-type]");
      if (!btn) return;
      pendingDeleteEventTypeId = btn.dataset.deleteEventType;
      deleteEventTypeName.textContent = btn.dataset.name;
      deleteEventTypeModal.classList.remove("hidden");
    });

    function closeDeleteEventTypeModal() {
      deleteEventTypeModal.classList.add("hidden");
      pendingDeleteEventTypeId = null;
    }
    document.getElementById("delete-event-type-cancel-btn")?.addEventListener("click", closeDeleteEventTypeModal);
    document.getElementById("delete-event-type-backdrop")?.addEventListener("click", closeDeleteEventTypeModal);

    deleteEventTypeConfirmBtn?.addEventListener("click", async () => {
      if (!pendingDeleteEventTypeId) return;
      deleteEventTypeConfirmBtn.disabled = true;
      try {
        const res = await fetch(`/api/event-types/${pendingDeleteEventTypeId}`, { method: "DELETE" });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || "Could not delete event type");
        }
        eventTypeList.querySelector(`[data-event-type-id="${pendingDeleteEventTypeId}"]`)?.remove();
        closeDeleteEventTypeModal();
      } catch (e) {
        eventTypeError.textContent = e.message;
        eventTypeError.classList.remove("hidden");
        closeDeleteEventTypeModal();
      } finally {
        deleteEventTypeConfirmBtn.disabled = false;
      }
    });

    // ── Delete account ──
    const modal = document.getElementById("delete-modal");
    const deleteError = document.getElementById("delete-error");
    const deleteBtn = document.getElementById("delete-confirm-btn");

    function openModal() {
      deleteError.classList.add("hidden");
      modal.classList.remove("hidden");
    }
    function closeModal() {
      modal.classList.add("hidden");
    }

    document.getElementById("open-delete-modal")?.addEventListener("click", openModal);
    document.getElementById("delete-cancel-btn")?.addEventListener("click", closeModal);
    document.getElementById("delete-modal-backdrop")?.addEventListener("click", closeModal);

    deleteBtn?.addEventListener("click", async () => {
      const password = hasPassword ? document.getElementById("delete-password")?.value : undefined;
      if (hasPassword && !password) {
        deleteError.textContent = "Enter your password to confirm";
        deleteError.classList.remove("hidden");
        return;
      }

      deleteBtn.disabled = true;
      deleteBtn.textContent = "Deleting…";

      try {
        const res = await fetch("/api/auth/me", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not delete account";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        window.location.href = "/login";
      } catch (e) {
        deleteError.textContent = e.message;
        deleteError.classList.remove("hidden");
        deleteBtn.disabled = false;
        deleteBtn.textContent = "Delete account";
      }
    });

    // ── Delete all events ──
    const eventsModal = document.getElementById("delete-events-modal");
    const deleteEventsError = document.getElementById("delete-events-error");
    const deleteEventsBtn = document.getElementById("delete-events-confirm-btn");

    function openEventsModal() {
      deleteEventsError.classList.add("hidden");
      eventsModal.classList.remove("hidden");
    }
    function closeEventsModal() {
      eventsModal.classList.add("hidden");
    }

    document.getElementById("open-delete-events-modal")?.addEventListener("click", openEventsModal);
    document.getElementById("delete-events-cancel-btn")?.addEventListener("click", closeEventsModal);
    document.getElementById("delete-events-modal-backdrop")?.addEventListener("click", closeEventsModal);

    deleteEventsBtn?.addEventListener("click", async () => {
      const password = hasPassword ? document.getElementById("delete-events-password")?.value : undefined;
      if (hasPassword && !password) {
        deleteEventsError.textContent = "Enter your password to confirm";
        deleteEventsError.classList.remove("hidden");
        return;
      }

      deleteEventsBtn.disabled = true;
      deleteEventsBtn.textContent = "Deleting…";

      try {
        const res = await fetch("/api/people", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Could not delete events";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        window.location.href = "/";
      } catch (e) {
        deleteEventsError.textContent = e.message;
        deleteEventsError.classList.remove("hidden");
        deleteEventsBtn.disabled = false;
        deleteEventsBtn.textContent = "Delete all events";
      }
    });

    // ── Import ──
    const importFile = document.getElementById("import-file");
    const importBtn = document.getElementById("import-btn");
    const importStatus = document.getElementById("import-status");
    const importErrors = document.getElementById("import-errors");
    const importDrop = document.getElementById("import-drop");
    const importDropText = document.getElementById("import-drop-text");
    const IMPORT_DROP_HINT = importDropText.textContent;
    // Highlight with background + ring, not border color: global.css sets
    // border-color on `*` unlayered, which beats any border-color utility.
    const DRAG_CLASSES = ["bg-zinc-100", "dark:bg-white/10", "ring-2", "ring-zinc-900/20", "dark:ring-white/25"];

    function syncImportFile() {
      const file = importFile.files?.[0];
      importDropText.textContent = file ? file.name : IMPORT_DROP_HINT;
      importBtn.disabled = !file;
    }

    importFile.addEventListener("change", syncImportFile);

    // Counter, not a boolean: dragenter/dragleave also fire for every child
    // element the pointer crosses, which would make the highlight flicker.
    let dragDepth = 0;
    importDrop.addEventListener("dragenter", (e) => {
      e.preventDefault();
      dragDepth++;
      importDrop.classList.add(...DRAG_CLASSES);
    });
    importDrop.addEventListener("dragover", (e) => e.preventDefault());
    importDrop.addEventListener("dragleave", () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) importDrop.classList.remove(...DRAG_CLASSES);
    });
    importDrop.addEventListener("drop", (e) => {
      e.preventDefault();
      dragDepth = 0;
      importDrop.classList.remove(...DRAG_CLASSES);
      const file = e.dataTransfer?.files?.[0];
      if (!file) return;
      const transfer = new DataTransfer();
      transfer.items.add(file);
      importFile.files = transfer.files;
      syncImportFile();
    });

    function showImportStatus(message, isError) {
      importStatus.textContent = message;
      importStatus.className = `text-sm px-3.5 py-2.5 rounded-lg mt-3 ${
        isError
          ? "bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"
          : "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
    }

    function plural(n, word) {
      return `${n} ${word}${n === 1 ? "" : "s"}`;
    }

    importBtn?.addEventListener("click", async () => {
      const file = importFile.files?.[0];
      importErrors.classList.add("hidden");
      importErrors.replaceChildren();
      if (!file) {
        showImportStatus("Choose a file first", true);
        return;
      }

      importBtn.disabled = true;
      importBtn.textContent = "Importing…";
      try {
        const form = new FormData();
        form.append("file", file);
        const res = await fetch("/api/data/import", { method: "POST", body: form });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.detail || "Could not import that file");

        const parts = [`${plural(data.events_added, "date")} added`];
        if (data.people_created) parts.push(`${plural(data.people_created, "new card")}`);
        if (data.event_types_created) parts.push(`${plural(data.event_types_created, "new event type")}`);
        if (data.events_skipped) parts.push(`${plural(data.events_skipped, "duplicate")} skipped`);
        if (data.invalid_rows) parts.push(`${plural(data.invalid_rows, "invalid row")} skipped`);
        showImportStatus(`Imported: ${parts.join(", ")}.`, false);

        for (const message of data.errors) {
          const li = document.createElement("li");
          li.textContent = message;
          importErrors.appendChild(li);
        }
        if (data.errors.length) importErrors.classList.remove("hidden");
        if (data.event_types_created) {
          // The event type list above is rendered from page load data.
          setTimeout(() => window.location.reload(), data.errors.length ? 6000 : 1500);
        }
        importFile.value = "";
      } catch (e) {
        showImportStatus(e.message, true);
      } finally {
        syncImportFile();
        importBtn.textContent = "Import";
      }
    });

    // ── Notification channels ──
    const CHANNEL_FIELDS = {
      email: [],
      ntfy: ["server", "topic", "access_token"],
      discord: ["webhook_url"],
      telegram: ["bot_token", "chat_id"],
      pushover: ["user_key", "api_token"],
    };

    function fieldId(channel, field) {
      return `${channel}-${field.replace(/_/g, "-")}`;
    }

    function showStatus(channel, message, isError) {
      const el = document.getElementById(`${channel}-status`);
      if (!el) return;
      el.textContent = message;
      el.className = `text-sm px-3.5 py-2.5 rounded-lg mb-3 ${
        isError
          ? "bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400"
          : "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
    }

    for (const c of initialChannels) {
      if (c.channel === "webpush") continue;
      const checkbox = document.getElementById(`${c.channel}-enabled`);
      if (checkbox) checkbox.checked = c.enabled;
      for (const field of CHANNEL_FIELDS[c.channel] || []) {
        const el = document.getElementById(fieldId(c.channel, field));
        if (el && c.config[field] !== undefined) el.value = c.config[field];
      }
    }

    const notifyTimeInput = document.getElementById("notify-time");
    notifyTimeInput.value = notifyTime;
    notifyTimeInput.addEventListener("change", async () => {
      if (!notifyTimeInput.value) return;
      try {
        const res = await fetch("/api/notifications/preferences", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ notify_time: notifyTimeInput.value }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || "Could not save");
        }
        showStatus("notify-time", "Saved.", false);
      } catch (e) {
        showStatus("notify-time", e.message, true);
      }
    });

    async function saveChannel(channel) {
      const enabled = document.getElementById(`${channel}-enabled`).checked;
      const config = {};
      for (const field of CHANNEL_FIELDS[channel] || []) {
        const el = document.getElementById(fieldId(channel, field));
        if (el) config[field] = el.value.trim();
      }
      try {
        const res = await fetch(`/api/notifications/channels/${channel}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ enabled, config }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || "Could not save");
        }
        showStatus(channel, "Saved.", false);
      } catch (e) {
        showStatus(channel, e.message, true);
      }
    }

    async function testChannel(channel) {
      try {
        const res = await fetch(`/api/notifications/channels/${channel}/test`, { method: "POST" });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || "Test failed");
        }
        showStatus(channel, "Test sent, check your device or app.", false);
      } catch (e) {
        showStatus(channel, e.message, true);
      }
    }

    document.querySelectorAll("[data-save]").forEach((btn) => {
      btn.addEventListener("click", () => saveChannel(btn.dataset.save));
    });
    document.querySelectorAll("[data-test]").forEach((btn) => {
      btn.addEventListener("click", () => testChannel(btn.dataset.test));
    });

    // ── Device (web push) notifications ──
    function urlBase64ToUint8Array(base64String) {
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const rawData = atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    const webpushToggleBtn = document.getElementById("webpush-toggle-btn");
    const webpushTestBtn = document.getElementById("webpush-test-btn");
    const webpushDescription = document.getElementById("webpush-description");

    async function getExistingSubscription() {
      if (!("serviceWorker" in navigator) || !("PushManager" in window)) return null;
      const reg = await navigator.serviceWorker.getRegistration().catch(() => null);
      if (!reg) return null;
      return reg.pushManager.getSubscription();
    }

    async function refreshWebpushUI() {
      if (!vapidPublicKey) {
        webpushDescription.textContent = "Device notifications aren't configured on this server.";
        webpushToggleBtn.disabled = true;
        return;
      }
      if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
        webpushDescription.textContent = "This browser doesn't support device notifications.";
        webpushToggleBtn.disabled = true;
        return;
      }
      const sub = await getExistingSubscription();
      webpushToggleBtn.textContent = sub ? "Disable on this device" : "Enable on this device";
      webpushTestBtn.hidden = !sub;
    }

    webpushToggleBtn?.addEventListener("click", async () => {
      webpushToggleBtn.disabled = true;
      try {
        const existing = await getExistingSubscription();
        if (existing) {
          await fetch("/api/notifications/webpush/unsubscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ endpoint: existing.endpoint }),
          });
          await existing.unsubscribe();
          showStatus("webpush", "Disabled on this device.", false);
        } else {
          const permission = await Notification.requestPermission();
          if (permission !== "granted") {
            throw new Error("Notification permission was not granted");
          }
          const reg = await navigator.serviceWorker.register("/sw.js");
          await navigator.serviceWorker.ready;
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
          const subJson = sub.toJSON();
          const res = await fetch("/api/notifications/webpush/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ endpoint: subJson.endpoint, keys: subJson.keys }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.detail || "Could not save subscription");
          }
          showStatus("webpush", "Enabled on this device.", false);
        }
      } catch (e) {
        showStatus("webpush", e.message, true);
      } finally {
        webpushToggleBtn.disabled = false;
        refreshWebpushUI();
      }
    });

    webpushTestBtn?.addEventListener("click", () => testChannel("webpush"));

    refreshWebpushUI();
  </script>

  <script>
    import { initDragReorder } from "../lib/dragReorder.js";

    const eventTypeList = document.getElementById("event-type-list");
    if (eventTypeList) {
      initDragReorder(eventTypeList, {
        onReorder: async (ids) => {
          const res = await fetch("/api/event-types/reorder", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids: ids.map(Number) }),
          });
          if (!res.ok) {
            const errorEl = document.getElementById("event-type-error");
            errorEl.textContent = "Could not save the new order.";
            errorEl.classList.remove("hidden");
          }
        },
      });
    }
  </script>
</Layout>
