---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Logo from "../components/Logo.astro";
import AuthHero from "../components/AuthHero.astro";
import PasswordInput from "../components/PasswordInput.astro";
import { apiJson } from "../lib/api";

if (Astro.cookies.get("candlr_token")?.value) {
  return Astro.redirect("/");
}

const cookies = Astro.request.headers.get("cookie") ?? "";

const oidcConfig = await apiJson<{ enabled: boolean; provider_name: string; disable_password_login: boolean }>(
  "/oidc/config",
  { cookies }
).catch(() => ({ enabled: false, provider_name: "SSO", disable_password_login: false }));

const registration = await apiJson<{ enabled: boolean }>("/auth/registration-status", { cookies }).catch(() => ({
  enabled: false,
}));

const passwordReset = await apiJson<{ enabled: boolean }>("/auth/password-reset-status", { cookies }).catch(() => ({
  enabled: false,
}));
---

<Layout title="Login">
  <div class="min-h-screen grid md:grid-cols-2">
    <AuthHero />

    <div class="relative flex items-center justify-center px-4 py-16">
      <div class="fixed top-4 right-4 z-20">
        <ThemeToggle class="p-2 rounded-lg bg-surface dark:bg-surface-dark border" />
      </div>

      <div class="w-full max-w-[360px]">
        <div class="mb-8">
          <div class="md:hidden mb-4">
            <Logo size="md" />
          </div>
          <h1 class="text-lg font-semibold tracking-tight">Welcome back</h1>
          <p class="text-zinc-500 dark:text-zinc-400 mt-1 text-sm">Sign in to your account</p>
        </div>

        <div class="card p-6 space-y-4">
          <div id="error-msg" class="hidden bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-sm px-3.5 py-2.5 rounded-lg"></div>

          {oidcConfig.enabled && (
            <a
              href="/oidc-start"
              class="btn-secondary flex items-center justify-center gap-2 w-full"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
              </svg>
              Sign in with {oidcConfig.provider_name}
            </a>
          )}

          {oidcConfig.enabled && !oidcConfig.disable_password_login && (
            <div class="relative py-1">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t"></div>
              </div>
              <div class="relative flex justify-center">
                <span class="bg-surface dark:bg-surface-dark px-3 text-xs text-zinc-400">or</span>
              </div>
            </div>
          )}

          {!oidcConfig.disable_password_login && (
            <>
              <div>
                <label class="label" for="username">Username</label>
                <input id="username" class="input" type="text" autocomplete="username" placeholder="your_username" tabindex="1" />
              </div>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="label mb-0" for="password">Password</label>
                  {passwordReset.enabled && (
                    <a href="/forgot-password" tabindex="4" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline">
                      Forgot password?
                    </a>
                  )}
                </div>
                <PasswordInput id="password" autocomplete="current-password" placeholder="••••••••" tabindex={2} />
              </div>
              <button id="login-btn" class="btn-primary w-full mt-1" tabindex="3">Sign in</button>
            </>
          )}
        </div>

        {!oidcConfig.disable_password_login && registration.enabled && (
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-4">
            No account? <a href="/register" class="text-zinc-900 dark:text-zinc-100 font-medium hover:underline">Create one</a>
          </p>
        )}
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById("login-btn") as HTMLButtonElement | null;
    const errEl = document.getElementById("error-msg")!;

    async function submit() {
      if (!btn) return;
      const username = (document.getElementById("username") as HTMLInputElement).value.trim();
      const password = (document.getElementById("password") as HTMLInputElement).value;
      if (!username || !password) return;

      btn.disabled = true;
      btn.textContent = "Signing in…";
      errEl.classList.add("hidden");

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password }),
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = "Login failed";
          try { detail = JSON.parse(text).detail ?? detail; } catch {}
          throw new Error(detail);
        }
        const data = await res.json();
        window.location.href = data.requires_2fa ? "/two-factor" : "/";
      } catch (e: any) {
        errEl.textContent = e.message;
        errEl.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Sign In";
      }
    }

    btn?.addEventListener("click", submit);
    ["username", "password"].forEach(id => {
      document.getElementById(id)?.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Enter") submit();
      });
    });
  </script>
</Layout>
